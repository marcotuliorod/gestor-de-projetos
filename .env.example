# Copie para .env e ajuste. NUNCA commite o .env real.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Postgres (usados pelo serviço db do docker-compose)
POSTGRES_DB=gestor
POSTGRES_USER=gestor
POSTGRES_PASSWORD=gestor

# URLs consumidas pelo Django (host 'db'/'redis' = nomes de serviço do compose)
DATABASE_URL=postgres://gestor:gestor@db:5432/gestor
REDIS_URL=redis://redis:6379/0

# GitHub App (coletor de status real) — App ID e installation_id aparecem na
# URL de instalação (github.com/settings/installations/<id>); a chave privada
# é o conteúdo do .pem gerado na página da App, em base64 (uma linha):
#   base64 -i minha-chave.pem | tr -d '\n'
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Token pessoal, usado SÓ para criar repositório no fluxo "criar projeto do
# zero" (RF-02) — todo o resto autentica pela GitHub App. É necessário
# porque uma App não consegue criar repositório em conta pessoal: o token de
# instalação não vale para POST /user/repos. Sem isso preenchido, o resto do
# sistema funciona normalmente e só esse fluxo responde com um aviso.
# Gere em github.com/settings/personal-access-tokens com permissão de
# criar repositórios na sua conta.
GITHUB_PAT=

# Execução de agentes — worktrees/mirrors ficam no volume 'agent-repos'
# (montado em /data/repos no docker-compose).
AGENTS_REPO_ROOT=/data/repos
# Nº de TaskRuns rodando de verdade ao mesmo tempo (RF-21) — pool prefork
# do Celery. Duas execuções do mesmo projeto continuam seguras (lock por
# projeto em apps/agents/workspace.py); projetos diferentes rodam em
# paralelo de verdade até este limite.
CELERY_WORKER_CONCURRENCY=4
# Enquanto o spike do Claude Agent SDK não roda, deixe True — nenhuma
# chamada de API externa é feita, o agente só escreve uma mudança de
# teste determinística no worktree.
AGENTS_FAKE_MODE=True
# Credencial do Claude Agent SDK (nome exato a confirmar durante o spike
# de implementação — ver apps/agents/agent_client.py). Só necessária com
# AGENTS_FAKE_MODE=False.
ANTHROPIC_API_KEY=

# Notificações Telegram (RF-14) — dispara quando um TaskRun precisa de
# revisão, falha, tem PR aberto, ou quando a fila noturna é pausada por
# orçamento. Sem isso configurado, notificações viram no-op silencioso.
# Setup:
#   1. Fale com @BotFather no Telegram, use /newbot e pegue o token.
#   2. Mande uma mensagem qualquer para o bot recém-criado.
#   3. Abra https://api.telegram.org/bot<token>/getUpdates no navegador
#      para descobrir seu chat_id (aparece em message.chat.id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
